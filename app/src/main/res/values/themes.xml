<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.EtCetera"
        parent="@style/Theme.Material3.DynamicColors.DayNight.NoActionBar">
    </style>

    <style name="Theme.EtCetera.Splash" parent="Theme.SplashScreen">
        <!-- Background color -->
        <item name="windowSplashScreenBackground">@mipmap/ic_launcher_background</item>
        <!-- Your app logo -->
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <!-- Animation duration -->
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <!-- Optional: remove status bar until transition -->
        <item name="postSplashScreenTheme">@style/Theme.EtCetera</item>
    </style>

</resources>